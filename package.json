{
  "name": "newra-ges-ipp-comparator",
  "private": true,
  "version": "1.0.0",
  "description": "NEWRA GES IPP Comparator — energy decision platform",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run prisma:migrate --prefix apps/backend",
    "db:seed": "npm run prisma:seed --prefix apps/backend",
    "dev:api": "npm run start:dev --prefix apps/backend",
    "dev:web": "npm run dev --prefix apps/frontend",
    "build:api": "npm run build --prefix apps/backend",
    "build:web": "npm run build --prefix apps/frontend",
    "test": "npm test --prefix apps/backend && npm test --prefix apps/frontend",
    "test:api": "npm test --prefix apps/backend",
    "test:web": "npm test --prefix apps/frontend"
  }
}
